
Reverse bits of a given 32 bits signed integer.

Example 1:

Input: n = 43261596

Output: 964176192

Explanation:

Integer	Binary
43261596	00000010100101000001111010011100
964176192	00111001011110000010100101000000
Example 2:

Input: n = 2147483644

Output: 1073741822

Explanation:

Integer	Binary
2147483644	01111111111111111111111111111100
1073741822	00111111111111111111111111111110
 
================================
class Solution {
    public int reverseBits(int n) {
        //first initialuze the ans with 0(32 bits)
        //00000000000000000000000000000000
       // int ans=0;
        //we have to find the binary no. at the LSB side of n 
        //n&1
        //n=0000000....0101(&)
        //1=000000000000001
        //=================
        // =000000000000001
        //int lsb=n&1; //1
        //ou task is to reverse bits, so we need to shift this lsb to opposite to
        //the current position of n.
        //since its 32 to bit, we need place this lsb by shifting with 31
        //after shifting with 31, it becomds 1000000000........0000000
        //int temp=lsb<<31;
        //now to store this temp to ans variables ,do a OR operation
     //   ans=ans|temp;
        //now to continue with next bits in n, do rightshift operation
        //again repeate same n&1 and shift with 30 and so on...
        //n=n>>1;
        int ans=0;

        for(int i=0;i<32;i++)
        {
            int lsb=n&1;
            int temp=lsb<<(31-i);
            ans=ans|temp;
            n=n>>1;
        }
        return ans;
    }
}
