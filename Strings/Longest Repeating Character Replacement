class Solution {
    public int characterReplacement(String s, int k) {
        //initializing an empty array to store the count of the characters in the given string s
        int[] arr=new int[26];
        int res=0;
        int max=0;

        //left pointer for the sliding window is l and right pointer is r
        int l=0;
        for(int r=0;r<s.length();r++)
        {
            //count the number of each character in the string s
            arr[s.charAt(r)-'A']++;

            //check the character with max number of freq
            max=Math.max(max,arr[s.charAt(r)-'A']);

            //now check if current window is valid or not
            if(r-l+1-max>k)
            {
                //this means number of replacements is more than allowed k
                //decrement the count of the character which was at l,bcz it is no longer 
                //in the window
                arr[s.charAt(l)-'A']--;
                l++;
            }

            //max our window can be
            res=Math.max(res,r-l+1);
        }

        return res;
    }
}


