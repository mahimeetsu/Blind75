class Solution {
    public int lengthOfLongestSubstring(String s) {
        int longest=0;
        int n=s.length();
        for(int i=0;i<n;i++)
        {
             int hash[]=new int[256];
            for(int j=i;j<n;j++)
            {
                if(hash[s.charAt(j)]==1)break;
                hash[s.charAt(j)]=1;
                int currLen=j-i+1;
                longest=Math.max(longest,currLen);
            }
        }

        return longest;
    }
}

