class Solution {
    public int[] productExceptSelf(int[] nums) {
        int n=nums.length;
         int prefix[]=new int[n];
         int prev=1;
         for(int i=0;i<n;i++)
         {
            prefix[i]=prev;
            prev=prev*nums[i];
         }
         prev=1;
        int suffix[]=new int[n];
         for(int i=n-1;i>=0;i--)
         {
            suffix[i]=prev;
            prev=prev*nums[i];
         }

         int res[]=new int[n];
         for(int i=0;i<n;i++)
         {
            res[i]=prefix[i]*suffix[i];
         }

         return res;
    }
}
