        int n=nums.length;
        int ans[]=new int[n];
        for(int i=0;i<n;i++)
        {
            int temp=1;
            for(int j=0;j<n;j++)
            {
                if(i!=j)
                {
                    temp=temp*nums[j];
                }
            }
            ans[i]=temp;
        }

        return ans;
